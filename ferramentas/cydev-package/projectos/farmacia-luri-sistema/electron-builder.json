{
  "appId": "com.skylayer.farmacialuri",
  "productName": "Farmácia Luri - Gestão",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "database/schema.sql",
    "electron/config/*.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "Farmácia Luri",
    "perMachine": false
  },
  "publish": {
    "provider": "none"
  }
}